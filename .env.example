# Copy to .env and fill in. Every value below is OPEN until M0 is done manually —
# see SETUP.md. Nothing in src/ will run live integrations without these.

# --- Minds (Builder API) ---
# From build.hellominds.ai after creating the Mind "Callback" and unlocking Builder access.
MINDS_BUILDER_API_KEY=
# The Mind's id, shown by `minds list` once created.
MINDS_MIND_ID=
# Keep this fixed so the Mind's context (people + asks memory) stays coherent across runs.
MINDS_CONVERSATION_ALIAS=callback-main

# --- YouTube Data API ---
# Google Cloud Console -> APIs & Services -> Credentials -> API key. Used for read-only calls
# (commentThreads.list, playlistItems.list, channels.list). Read quota cost: 1 unit/call.
YOUTUBE_API_KEY=
# OAuth 2.0 client (Testing mode; the test channel's Google account added as a test user).
# Used for comments.insert (posting replies), the F4 own-uploads poll (an API key alone never
# sees an unlisted upload, only the owner's OAuth-authenticated request does), and the F6
# privacyStatus check before posting. Scope: youtube.force-ssl.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# The persona test channel Callback is allowed to post replies on. Posting is refused for any
# other channel id, even in dry-run mode dry-run never posts at all.
YOUTUBE_TEST_CHANNEL_ID=
YOUTUBE_QUOTA_DAILY_UNITS=10000

# --- Creator profile (used in prompts and the Sunday brief schedule) ---
CREATOR_DISPLAY_NAME=Mei
# IANA zone name, e.g. America/Chicago (CDT during the build week).
CREATOR_TIMEZONE=America/Chicago

# --- Service ---
PORT=3000
DB_PATH=./data/callback.sqlite
# Every 30 min per F1; every 10 min per F4; every 30 sec per F6 (re-checks the answering
# video's privacyStatus and posts once it's public). All three accept an override for local testing.
HARVEST_INTERVAL_MIN=30
UPLOAD_POLL_INTERVAL_MIN=10
POSTING_POLL_INTERVAL_SEC=30
